# ==============================================
# HappyPaws - Environment Variables Example
# Copy this file to .env and fill in your values
# ==============================================

# --- Database ---
DB_NAME=clinic
DB_USER=happypaws
DB_PASSWORD=happypaws
DB_ROOT_PASSWORD=happypaws_root

# --- Backend ---
# JWT secret key (use a long random string in production)
JWT_SECRET=changeme_use_a_long_random_string_here

# --- Frontend ---
# URL of the backend API (accessible from the browser)
REACT_APP_API_URL=http://localhost:8082/api

# ML chatbot service URL (optional - leave empty to disable chatbot)
# REACT_APP_ML_URL=http://localhost:5000
